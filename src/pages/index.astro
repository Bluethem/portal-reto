---
const title = "Bomba en Cadena";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: system-ui, sans-serif;
      }
      body {
        margin: 0;
        background: #0b0e14;
        color: #e6e9f0;
      }
      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 1.5rem 1rem 2rem;
      }
      h1 {
        font-size: 1.4rem;
        margin: 0 0 0.75rem;
      }
      .row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      .pill {
        border: 1px solid #2a2f3a;
        border-radius: 999px;
        padding: 0.35rem 0.8rem;
        background: #12161f;
        font-size: 0.85rem;
      }
      .pill .label {
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #8b93a7;
        font-size: 0.65rem;
        display: block;
      }
      #status.ready {
        color: #4ade80;
      }
      #status.connecting {
        color: #facc15;
      }
      #status.blocked {
        color: #f87171;
      }
      #stage {
        position: relative;
        margin-top: 0.75rem;
      }
      #scene {
        width: 100%;
        height: 440px;
        display: block;
        border: 1px solid #2a2f3a;
        border-radius: 12px;
        background: #0b0e14;
      }
      #manual {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        max-width: 320px;
        background: rgba(10, 13, 20, 0.85);
        border: 1px solid #2a2f3a;
        border-radius: 10px;
        padding: 0.6rem 0.9rem;
        font-size: 0.85rem;
        pointer-events: none;
      }
      #manual h2 {
        font-size: 0.95rem;
        margin: 0 0 0.25rem;
      }
      #manual p {
        margin: 0;
        color: #aeb6c4;
      }
      .mod-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
        margin-top: 0.75rem;
      }
      .mod {
        border: 1px solid #2a2f3a;
        border-radius: 8px;
        padding: 0.5rem;
        text-align: center;
        font-size: 0.85rem;
        background: #12161f;
      }
      .mod.on {
        border-color: #4ade80;
        color: #4ade80;
      }
      .mod.lock {
        opacity: 0.4;
      }
      ul {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 0;
        font-size: 0.8rem;
        color: #aeb6c4;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Bomba en Cadena</h1>
      <div class="row">
        <div class="pill">
          <span class="label">Conexión</span>
          <span id="status">conectando...</span>
        </div>
        <div class="pill">
          <span class="label">Mi rol</span>
          <span id="role">—</span>
        </div>
        <div class="pill">
          <span class="label">Timer</span>
          <span id="timer">--:--</span>
        </div>
        <div class="pill">
          <span class="label">Strikes</span>
          <span id="strikes">0/3</span>
        </div>
        <div class="pill">
          <span class="label">Progreso</span>
          <span id="progress">0%</span>
        </div>
      </div>
      <div id="stage">
        <canvas id="scene"></canvas>
        <div id="manual"></div>
      </div>
      <div class="mod-grid" id="modules"></div>
      <div class="pill" style="margin-top:0.75rem">
        <span class="label">Jugadores</span>
        <ul id="players"></ul>
      </div>
    </main>
    <script>
      import { connectBomb } from "../bomb/portal/client";
      import { bootBomb } from "../bomb";
      import { formatMs, formatPercent } from "../bomb/shared/timer";

      const bomb = connectBomb();

      const canvas = document.getElementById("scene");
      const manual = document.getElementById("manual");
      if (canvas instanceof HTMLCanvasElement && manual) {
        bootBomb({ canvas, manual });
      }

      const statusEl = document.getElementById("status");
      const roleEl = document.getElementById("role");
      const playersEl = document.getElementById("players");
      const timerEl = document.getElementById("timer");
      const progressEl = document.getElementById("progress");
      const strikesEl = document.getElementById("strikes");
      const modsEl = document.getElementById("modules");

      bomb.subscribeChannelStatus((s) => {
        if (!statusEl) return;
        statusEl.textContent = s;
        statusEl.className = s;
      });

      bomb.subscribeRole((r) => {
        if (!roleEl) return;
        roleEl.textContent = r === null ? "—" : `M${r}`;
      });

      bomb.subscribePresence((players) => {
        if (!playersEl) return;
        playersEl.replaceChildren();
        for (const p of players) {
          const li = document.createElement("li");
          li.textContent = `${p.host ? "[host] " : ""}${p.id} — rol ${p.role ?? "sin asignar"}`;
          playersEl.appendChild(li);
        }
      });

      bomb.subscribeBomb((state) => {
        if (!timerEl || !progressEl || !strikesEl || !modsEl) return;
        if (!state) {
          timerEl.textContent = "--:--";
          progressEl.textContent = "0%";
          strikesEl.textContent = "0/3";
          modsEl.replaceChildren();
          return;
        }
        timerEl.textContent = formatMs(state.timerMs);
        progressEl.textContent = formatPercent(state.progress);
        const strikes = state.modules.reduce((acc, m) => acc + m.strikes, 0);
        strikesEl.textContent = `${strikes}/3`;
        modsEl.replaceChildren();
        for (const m of state.modules) {
          const div = document.createElement("div");
          div.className = `mod ${m.defused ? "on" : ""} ${m.unlocked ? "" : "lock"}`;
          const estado = m.defused ? "listo" : m.unlocked ? "activo" : "bloqueado";
          div.textContent = `M${m.id} ${estado}`;
          modsEl.appendChild(div);
        }
      });
    </script>
  </body>
</html>
